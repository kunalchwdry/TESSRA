# ---- Database (required) -----------------------------------------------
# Local sandbox default; use your Supabase Postgres connection string in production
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# ---- Supabase ----------------------------------------------------------
# Get these from your Supabase project: Settings → API
# Use the "Transaction mode" pooler (port 6543) for Next.js serverless
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=   # server-only, NEVER expose to the browser

# When configured, the app uses Supabase Auth (email+password) instead of
# custom session cookies. When left blank, the app falls back to its built-in
# session-cookie auth layer (works without Supabase).

# ---- Scheduling engine --------------------------------------------------
# Leave ENGINE_URL empty to run engine/solve.py as a local subprocess (needs
# python3 + ortools: `pip install ortools`). For production set the URL of the
# FastAPI service (engine/app.py) deployed on Render/Railway.
ENGINE_URL=
ENGINE_TOKEN=
# Comma-separated origins allowed to call the engine service
ENGINE_ALLOWED_ORIGINS=http://localhost:3000
PYTHON_BIN=python3

# ---- Optional LLM provider (assistant works without it) -----------------
AI_PROVIDER=                 # e.g. openai | anthropic — optional
AI_API_KEY=                  # optional; never committed
AI_MODEL=
